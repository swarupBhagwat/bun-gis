{
  "name": "bun-gis",
  "version": "0.1.0",
  "description": "Bun-native CLI and TypeScript toolkit for downloading Overture Maps data as GeoJSON, GeoJSONSeq, GeoParquet or KML",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarupBhagwat/bun-gis.git"
  },
  "homepage": "https://github.com/swarupBhagwat/bun-gis#readme",
  "bugs": {
    "url": "https://github.com/swarupBhagwat/bun-gis/issues"
  },
  "keywords": [
    "gis",
    "geojson",
    "overture",
    "geoparquet",
    "bun",
    "cli",
    "kml",
    "geojsonseq",
    "overture-maps"
  ],
  "bin": {
    "bun-gis": "src/cli/index.ts"
  },
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun src/cli/index.ts validate",
    "ui": "bun ui/server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@turf/kinks": "^7.4.0",
    "hyparquet": "^1.31.2",
    "hyparquet-writer": "^0.16.10"
  }
}
